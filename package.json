{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "test:security": "npm run build && node --test --test-isolation=none tests/security-regression.test.cjs",
    "test:billing": "npm run build && node --test tests/billing-regression.test.cjs",
    "test:mvp": "npm run build && node --test tests/mvp-integration.test.cjs",
    "test:checkout": "npm run build && node --test tests/credit-checkout.test.cjs",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "migrate:branch-clients": "node --env-file-if-exists=.env scripts/migrate-branch-clients.js",
    "seed": "ts-node src/infrastructure/database/seeders/seed.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@types/multer": "^2.1.0",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.10.0",
    "mongoose": "^8.4.0",
    "multer": "^2.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "$multer"
    }
  }
}
