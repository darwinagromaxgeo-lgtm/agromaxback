# Copy into the deployment environment. Do not commit real credentials.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/agromax
JWT_SECRET=replace-with-a-private-random-value
JWT_EXPIRES_IN=24h
# Required only when creating the first admin in an empty production database.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173

# Separate backend-to-microservice integration. Disabled until verified.
GREENTER_ENABLED=false
GREENTER_SIMULATION_ENABLED=false
DECOLECTA_API_KEY=
GREENTER_SERVICE_URL=https://your-invoice-service.example
GREENTER_API_KEY=
GREENTER_ISSUER_RUC=
GREENTER_ENVIRONMENT=beta
GREENTER_ALLOW_PRODUCTION=false
GREENTER_SERIE_FACTURA=
GREENTER_SERIE_BOLETA=

# REQUIRED: confirm the next unused fiscal number before enabling emission.
# Shared by RUC + series + environment across Agromax branches/tax groups.
GREENTER_FACTURA_NEXT_NUMBER=
GREENTER_BOLETA_NEXT_NUMBER=
# Starting RC number for a new daily-summary counter. Coordinate with other
# applications if they issue summaries for the same RUC on the same day.
GREENTER_SUMMARY_NEXT_NUMBER=

# Series exclusivas FAGx/BAGx seleccionadas por billingSeriesCode de la sucursal.
GREENTER_BRANCH_NUMBERING=false
# Solo en modo summary: si el RUC también envía resúmenes desde otro software,
# coordinar un rango. El envío individual de boletas no utiliza estos valores.
# exclusivo antes de habilitar boletas. Estos valores no reservan nada en SUNAT.
GREENTER_EXTERNAL_BILLING_ACTIVE=false
GREENTER_SUMMARY_LAST_NUMBER=
GREENTER_SUMMARY_RANGE_CONFIRMED=false
